# Shared commands and navigation keys.
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu wmenu-run
set $lock swaylock -f -c 202020

output * bg #363636 solid_color
focus_wrapping no
focus_follows_mouse no
default_border none
gaps inner 6

include conf.d/input.conf
include conf.d/bindings.conf
include conf.d/session.conf

# Distribution integration first; personal overrides always last.
include /etc/sway/config.d/*
include local.conf
