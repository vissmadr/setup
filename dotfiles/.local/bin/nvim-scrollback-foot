#!/usr/bin/env bash
set -euo pipefail

scrollback="$(mktemp --suffix=.terminal-scrollback)"
trap 'rm -f -- "$scrollback"' EXIT
cat > "$scrollback"

# Use normal Neovim behavior; only persistent history for this temporary file is disabled.
arguments=(-n -i NONE '+setlocal noundofile' '+normal! G0' "$scrollback")
if command -v foot >/dev/null 2>&1; then
  foot --app-id=terminal-scrollback nvim "${arguments[@]}"
else
  nvim "${arguments[@]}"
fi
