#!/usr/bin/env bash
set -euo pipefail

arguments=()
case "${1:-region}" in
  region)
    geometry="$(slurp)" || exit 0
    [[ -n "$geometry" ]] || exit 0
    arguments=(-g "$geometry")
    ;;
  full) ;;
  *) echo 'Usage: sway-screenshot [region|full]' >&2; exit 2 ;;
esac

directory="$HOME/Pictures/screenshots"
mkdir -p "$directory"
image="$(mktemp "$directory/$(date +%Y%m%d-%H%M%S)-XXXXXX.png")"
if ! grim "${arguments[@]}" "$image"; then
  rm -f -- "$image"
  exit 1
fi
wl-copy --type image/png < "$image"
printf '%s\n' "$image"
