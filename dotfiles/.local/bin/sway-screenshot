#!/usr/bin/env bash
set -euo pipefail

arguments=()
case "${1:-region}" in
  region)
    geometry="$(slurp)" || exit 0
    [[ -n "$geometry" ]] || exit 0
    arguments=(-g "$geometry")
    ;;
  full) ;;
  *) echo 'Usage: sway-screenshot [region|full]' >&2; exit 2 ;;
esac

directory="$HOME/Pictures/screenshots"
mkdir -p "$directory"
timestamp="$(date +%Y%m%d-%H%M%S)"
image="$directory/$timestamp.png"
suffix=0
# Reserve atomically so simultaneous captures cannot overwrite each other.
while ! (umask 077; set -o noclobber; : > "$image") 2>/dev/null; do
  if [[ ! -e "$image" && ! -L "$image" ]]; then
    echo "Cannot create screenshot: $image" >&2
    exit 1
  fi
  suffix=$((suffix + 1))
  image="$directory/$timestamp-$suffix.png"
done
if ! grim "${arguments[@]}" "$image"; then
  rm -f -- "$image"
  exit 1
fi
wl-copy --type image/png < "$image"
printf '%s\n' "$image"
